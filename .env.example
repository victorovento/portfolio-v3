# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PlayStation NPSSO token: log in at playstation.com, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the "npsso" value.
# This is a login session for your account. Never commit or share it.
PSN_NPSSO=

# Spotify: create an app at https://developer.spotify.com/dashboard
# (redirect URI http://127.0.0.1:8888/callback), then run npm run spotify:auth
# to fill in SPOTIFY_REFRESH_TOKEN automatically.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# X (Twitter): developer.x.com -> your app -> Keys and tokens -> Bearer Token
X_BEARER_TOKEN=
# Hours between API calls (free tier has very few reads per month)
# X_MIN_HOURS=12
